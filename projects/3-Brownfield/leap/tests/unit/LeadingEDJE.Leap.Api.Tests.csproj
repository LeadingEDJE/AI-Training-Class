<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Explicit assembly identity (Phase 48 plan 48-08). The API csproj's <InternalsVisibleTo>
         names this exact ASSEMBLY name, so the two must stay in step. Note the .csproj FILENAME
         must keep the capital-T `Tests` substring: Directory.Build.props gates
         GenerateDocumentationFile on a CASE-SENSITIVE MSBuildProjectName.Contains('Tests'), and a
         lowercase or short filename would flip XML-doc generation ON for this test assembly and
         flood it with fatal CS1591. -->
    <AssemblyName>LeadingEDJE.Leap.Api.Tests</AssemblyName>
    <RootNamespace>LeadingEDJE.Leap.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Phase 41: the API's Microsoft.AspNetCore.DataProtection.EntityFrameworkCore 10.0.1 flows in
         transitively via the ProjectReference below, dragging Microsoft.AspNetCore.DataProtection
         10.0.1 and System.Security.Cryptography.Xml 10.0.1 — both flagged by the NuGet audit
         (NU1903/NU1904 -> errors under TreatWarningsAsErrors). Unlike the Web-SDK API project,
         this test project does not prune those framework-provided packages, so pin them to the
         current patched release. Not EF Core packages -> the 10.0.1 EF Core lock is unaffected. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!-- Unify the transitive EF Core graph at 10.0.10 (43-09). Npgsql 10.0.3 (via the referenced API
         project) floors Relational at 10.0.4, but the API is compiled against 10.0.10 (its Design
         package pins it there but is PrivateAssets, so it does not flow here). Without this explicit
         reference the resolved Relational drops to 10.0.4 and MSB3277 breaks the 0-warning gate. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Quartz" Version="3.20.1" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\LeadingEDJE.Leap.Api.csproj" />
  </ItemGroup>

</Project>
