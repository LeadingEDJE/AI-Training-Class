<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Explicit assembly identity (Phase 48 plan 48-08). The .csproj FILENAME must keep the
         capital-T `Tests` substring — see the note in LeadingEDJE.Leap.Api.Tests.csproj. -->
    <AssemblyName>LeadingEDJE.Leap.Api.IntegrationTests</AssemblyName>
    <RootNamespace>LeadingEDJE.Leap.Api.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed TPS-shaped export bundle for the 43-05 round-trip proof (P43-D). -->
    <Content Include="TestData\tps-export-fixture\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Phase 41: pin the DataProtection transitives dragged in via the API ProjectReference to
         the current patched release (audit NU1903/NU1904 -> errors otherwise). This project does
         not prune them like the Web-SDK API does. Not EF Core packages -> EF Core lock unaffected.
         See LeadingEDJE.Leap.Api.Tests.csproj for the full rationale. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Unify the transitive EF Core graph at 10.0.10 (43-09). Npgsql 10.0.3 floors Relational at
         10.0.4, but the referenced API + Tests projects are compiled against 10.0.10; without this
         explicit reference MSB3277 breaks the 0-warning gate. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Quartz" Version="3.20.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Transitive pin: Testcontainers 4.13.0 (the latest release) still floors SSH.NET at
         2025.1.0, which GHSA-q939-rpr3-3284 (high, published 2026-08-12) covers via `<= 2025.1.0`.
         NuGet audit raises NU1903 -> error, failing restore for the whole solution. 2026.0.0 is the
         first patched release. Only CI sees this: the advisory is in the GitHub Advisory Database,
         which audit reaches through the authenticated LeadingEDJE feed in nuget.config, so an
         unauthenticated local restore reads only nuget.org's narrower index and passes.
         DROP THIS LINE once Testcontainers ships a release that floors SSH.NET at 2026.0.0. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\LeadingEDJE.Leap.Api.csproj" />
    <ProjectReference Include="..\unit\LeadingEDJE.Leap.Api.Tests.csproj" />
  </ItemGroup>

</Project>
