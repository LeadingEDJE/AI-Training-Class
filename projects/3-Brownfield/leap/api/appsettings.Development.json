{
  // Local dev gets the destructive developer tools (the Compass data clear in the LEAP launcher).
  // Still gated on the Compass Super Admin role, which the default DevBypass profile holds.
  "DeveloperTools": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Cors": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "https://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://localhost:5176"]
  },
  "Slack": {
    "_comment": "Real values loaded from dotnet user-secrets. Set via: dotnet user-secrets set Slack:BotToken <token> --project api"
  },
  "GoogleAuth": {
    "AllowedDomain": "leadingedje.com",
    "Groups": [
      { "GroupName": "Timesheet-SuperAdmin-dev", "Role": "SuperAdmin" },
      { "GroupName": "Timesheet-Admin-dev", "Role": "HR" },
      { "GroupName": "Timesheet-Config-dev", "Role": "Admin" },
      { "GroupName": "Timesheet-Approval-dev", "Role": "Manager" },
      { "GroupName": "Timesheet-Invoicing-dev", "Role": "TimesheetProcessor" },
      { "GroupName": "Timesheet-Payroll-dev", "Role": "PayrollProcessor" },
      { "GroupName": "Timesheet-Accounting-dev", "Role": "Accounting" },
      { "GroupName": "Timesheet-Ops-dev", "Role": "Ops" },

      // Compass (Phase 49). Each role maps from BOTH the production Google group and the
      // "-dev" Google group. Names are space-free (same shape as Timesheet-*-dev), verified from
      // a live SAML assertion (Attribute Name="Groups"). Copy byte-exactly — a typo grants
      // nothing, silently.
      //
      // A Compass group must NEVER map to one of the nine bare timesheet role strings; startup
      // validation rejects that, and the isolation tests assert it in both directions.
      { "GroupName": "Compass-SuperAdmin", "Role": "Compass Super Admin" },
      { "GroupName": "Compass-SuperAdmin-dev", "Role": "Compass Super Admin" },
      { "GroupName": "Compass-Admin", "Role": "Compass Admin" },
      { "GroupName": "Compass-Admin-dev", "Role": "Compass Admin" },
      { "GroupName": "Compass-Ops", "Role": "Compass Ops" },
      { "GroupName": "Compass-Ops-dev", "Role": "Compass Ops" },
      { "GroupName": "Compass-Sales", "Role": "Compass Sales" },
      { "GroupName": "Compass-Sales-dev", "Role": "Compass Sales" }
    ]
  },
  "Auth": {
    "DevBypass": {
      "DefaultProfile": "superadmin",
      "Profiles": {
        "superadmin": {
          "EdjeId": "08d6f1bd-385a-b143-fb9a-87fc7cc33492",
          "Email": "avery.quinn@example.com",
          "Privileges": ["EDJEr", "Manager", "TimesheetProcessor", "Accounting", "HR", "Ops", "PayrollProcessor", "Admin", "SuperAdmin", "Compass Super Admin"]
        },
        "erica": {
          "EdjeId": "00000000-0000-0000-0000-000000000002",
          "Email": "erica@leadingedje.com",
          "Privileges": ["EDJEr", "TimesheetProcessor", "SuperAdmin"]
        },
        "manager-bob": {
          "EdjeId": "00000000-0000-0000-0000-000000000003",
          "Email": "bob@leadingedje.com",
          "Privileges": ["EDJEr", "Manager"]
        },
        "edjer-alice": {
          "EdjeId": "00000000-0000-0000-0000-000000000004",
          "Email": "alice@leadingedje.com",
          "Privileges": ["EDJEr"]
        }
      }
    }
  }
}
