        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Given name. Required."
          },
          "lastName": {
            "type": "string",
            "description": "Family name. Required."
          },
          "hireDate": {
            "type": "string",
            "description": "Date of hire. Required.",
            "format": "date"
          },
          "email": {
            "type": "string",
            "description": "Required, and unique across every EDJEr, active or inactive, compared case-insensitively and trimmed\n(BR-9, spec A-2)."
          },
          "employeeTypeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The employment classification. Must name an active employee type — the server refuses an\ninactive one even though the selection list omits it (FR-005).",
            "format": "int32"
          },
          "coachEmployeeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Another EDJEr who coaches this one. Optional (AC-17). The mockup marks it required; the\nacceptance criterion wins.",
            "format": "int32"
          },
          "stateOfResidence": {
            "type": "string",
            "description": "A USPS code from the 50 states plus DC (FR-014)."
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the EDJEr is with Leading EDJE. Turning this off is refused while they hold an assignment\nwith no end date (FR-019, BR-10)."
          },
          "timesheetRequired": {
            "type": "boolean",
            "description": "Time-tracking setting, Super-Admin-only (BR-1)."
          },
          "canSubmitUnder40": {
            "type": "boolean",
            "description": "Time-tracking setting, Super-Admin-only (BR-1)."
          },
          "includeInPayroll": {
            "type": "boolean",
            "description": "Time-tracking setting, Super-Admin-only (BR-1)."
          },
          "timezone": {
            "type": [
              "null",
              "string"
            ],
            "description": "The EDJEr's IANA timezone — one of string[] UsTimeZones.All (FR-8.1). Required of the\nscreen; optional on the wire, and that is not an oversight. `/api/compass/v1` is\nadditive-only (FR-082, ADR-004), and `oasdiff` classifies a NEW REQUIRED request property as\na breaking change — so a required parameter here would have to be `v2`. Absent is therefore\naccepted and means \"say nothing about the timezone\": a create falls back to\nstring UsTimeZones.Default (the same value the column defaults to) and an update leaves the\nstored zone alone. Present-but-blank is a rejection, not a fallback — that is what a form\nsends when the administrator picked nothing, and silently filing them under Eastern is exactly\nwhat FR-8.1 asks the screen to stop doing."
          },
          "legacyTpsId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The identifier this record carried in the legacy TPS directory. Only the migration principal\nmay supply it (CompassLegacyProvenance); any other caller sending a value is\nrefused rather than having it quietly dropped, on create and on update alike. Absent for\neverything a person creates. Immutable once set: an authorised caller may re-send it on an\nupdate, but it is not re-applied."
          },
          "isDeliveryTeam": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Whether the EDJEr is on the delivery team (issue #502). Nullable and trailing, both deliberately.\nA non-nullable `bool` binds `false` for a client that says nothing, which is the one\nvalue that must never be inferred; and `/api/compass/v1` is additive-only (FR-082, ADR-004),\nso a new required request property would be breaking and force a `v2`. Absent therefore\nmeans \"say nothing about it\": a create falls back to `true`, the value the column itself\ndefaults to, and an update leaves the stored flag alone, so a hand-made correction survives a\nsave by a client older than this field. It goes after LegacyTpsId because the\nETL passes the leading arguments positionally."
          }
        },
        "description": "Adds or updates an EDJEr. Captures exactly AC-17's field set."
      },
