  "components": {
    "schemas": {
      "CompassAssignmentDto": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The assignment's identifier — `compass.client_assignment.client_assignment_id`.",
            "format": "int32"
          },
          "employeeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The assigned EDJEr's identifier — `compass.employee.employee_id`.",
            "format": "int32"
          },
          "clientId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The client's identifier — `compass.client.client_id`.",
            "format": "int32"
          },
          "clientName": {
            "type": "string",
            "description": "The client's name, resolved here so every consumer avoids a second round trip."
          },
          "startDate": {
            "type": "string",
            "description": "The engagement's start date.",
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The engagement's end date. `null` means open-ended.",
            "format": "date"
          },
          "note": {
            "type": [
              "null",
              "string"
            ],
            "description": "Free-text note. Nullable."
          },
          "effectiveInvoiceFrequency": {
            "type": [
              "null",
              "string"
            ],
            "description": "The invoicing cadence name that actually applies to this engagement (FR-012): the assignment's\nown override where set, else the client's default, else `null`."
          }
        },
        "description": "A published client assignment — read family 3 of the Compass Directory boundary (FR-006, FR-012)."
      },
      "CompassBillableCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The category's identifier -- `compass.billable_time_category.billable_time_category_id`.",
            "format": "int32"
          },
          "clientId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The owning client's identifier -- `compass.client.client_id`.",
            "format": "int32"
          },
          "categoryName": {
            "type": "string",
            "description": "The category's display name. Unique per client, not globally."
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the category is currently offered. Retired categories are kept, never deleted, and are\nstill returned by this read -- see the asymmetry note above."
          }
        },
        "description": "One client-scoped billable time category, published for a given client -- read family 6 of the\nCompass Directory boundary (FR-009)."
      },
      "CompassClientDto": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The client's identifier — `compass.client.client_id`.",
            "format": "int32"
          },
          "clientName": {
            "type": "string",
            "description": "The unique client name."
          },
          "msaSignedDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Master Service Agreement signed date. Optional.",
            "format": "date"
          },
          "ndaSignedDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Non-Disclosure Agreement signed date. Optional.",
            "format": "date"
          },
          "isInternal": {
            "type": "boolean",
            "description": "The internal-EDJE (\"beach\") indicator — an assignment to a client with this set is what the\ndashboard's \"on the beach\" tile counts."
          },
          "invoiceFrequency": {
            "type": [
              "null",
              "string"
            ],
            "description": "The client's default invoicing cadence name, resolved through `InvoiceFrequencyTypeId`."
          },
          "status": {
            "type": "string",
            "description": "Derived per response from the client's assignments (BR-11); never stored, settable or null.\nA closed set of three: \"Former\" once every assignment has ended, \"Inactive\" if none ever did."
          }
        },
        "description": "A published client, with a status derived at read time — read family 2 of the Compass Directory\nboundary (FR-005)."
      },
      "CompassClientRequest": {
        "required": [
          "clientName",
          "msaSignedDate",
          "ndaSignedDate",
          "isInternal",
          "invoiceFrequencyTypeId"
        ],
        "type": "object",
        "properties": {
          "clientName": {
            "type": "string",
            "description": "Required, and unique across clients."
          },
          "msaSignedDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Master Service Agreement signed date. Optional.",
            "format": "date"
          },
          "ndaSignedDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Non-Disclosure Agreement signed date. Optional.",
            "format": "date"
          },
          "isInternal": {
