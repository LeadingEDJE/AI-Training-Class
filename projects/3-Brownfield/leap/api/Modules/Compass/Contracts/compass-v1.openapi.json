{
  "openapi": "3.1.1",
  "info": {
    "title": "LeadingEDJE.Leap.Api | compass-v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/compass/v1/employees/{id}": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns one Compass employee (EDJEr) by id.",
        "description": "Read family 1 of the Compass Directory boundary (FR-004). Returns 404 when id does not match an existing employee — including a caller who cannot see the record at all, which the route's own authorization policy already refuses with 403 before this handler runs (see the type-level remarks on identifier enumerability). `TimeTracking` is present only for a Compass Super Admin caller; every other authorized tier gets the field omitted, not null.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompassEmployeeDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/compass/v1/employees/{id}/assignments": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns every assignment held by the given employee.",
        "description": "Read family 3 (spec 009 Slice 5, FR-006). No not-found case: an unknown or assignment-less employee simply has zero assignments, matching the collection-GET shape of the invoice-frequencies (Slice 2) and billable-categories (Slice 4) reads rather than the single-resource GetById.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompassAssignmentDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/compass/v1/invoice-frequencies": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns every active invoice frequency type.",
        "description": "Read family 7 (spec 009 Slice 2, FR-010). No id parameter and no not-found case — this is a flat lookup, always 200. Filters to active types server-side, so every row in the response is active by construction; see CompassInvoiceFrequencyDto's remarks for why there is no `IsActive` field to check instead.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompassInvoiceFrequencyDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/compass/v1/clients/{id}": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns one Compass client by id, with its status DERIVED at read time.",
        "description": "Read family 2 of the Compass Directory boundary (spec 009 Slice 3, FR-005). Returns 404 when id does not match an existing client. `Status` is always \"Active\" or \"Inactive\", computed from the client's assignments — see CompassClientDto's own remarks for why there is no stored status column to read instead.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompassClientDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/compass/v1/clients/{id}/billable-categories": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns every billable time category configured for the given client.",
        "description": "Read family 6 (spec 009 Slice 4, FR-009). Returns EVERY category, active and inactive alike — see CompassBillableCategoryDto's remarks for why. No not-found case: an unknown client id simply has no categories, so this always returns 200 with a (possibly empty) list, matching the shape of the invoice-frequencies collection read (Slice 2) rather than the single-resource GetById.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompassBillableCategoryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/compass/v1/clients/{id}/assignments": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns every assignment at the given client.",
        "description": "Read family 3 (spec 009 Slice 5, FR-006). No not-found case: an unknown or assignment-less client simply has zero assignments, matching the collection-GET shape above.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompassAssignmentDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/compass/v1/assignments/{id}": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns one client assignment by id.",
        "description": "Read family 3 of the Compass Directory boundary (spec 009 Slice 5, FR-006). Returns 404 when id does not match an existing assignment. The SAME contract (CompassAssignmentDto) also backs the two owner-scoped collection reads — `employees/{id}/assignments` and `clients/{id}/assignments` — this route is the bare, single-resource lookup.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompassAssignmentDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/compass/v1/assignments/{id}/sows": {
      "get": {
        "tags": [
          "Compass"
        ],
        "summary": "Returns every SOW (statement of work / contract period) under the given assignment.",
        "description": "Read family 4 (spec 009 Slice 6, FR-007). No not-found case: an unknown or SOW-less assignment simply has zero SOWs, matching the collection reads elsewhere on this boundary. `RateIncrease`/`Note` are present only for an Elevated-tier-or-above caller; every other authorized tier gets them omitted, not null.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompassDirectorySowDto"
                  }
                }
              }
            }
          }
        }
      }
    },
