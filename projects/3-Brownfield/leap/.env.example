# LEAP application database — PostgreSQL 16 (Phase 42 Postgres re-platform)
# 127.0.0.1, not localhost: on Windows `localhost` resolves to ::1 first, which Docker Desktop's
# port forward can accept and then abort — it reads as "database unreachable" against a healthy
# container. Matches the Makefile's POSTGRES_HOST default.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=leap_dev
POSTGRES_USER=timesheet
# Must match the password every Makefile target and web/compass/playwright.config.ts pass to the
# client; the container is initialized from this value, so a different one here fails 28P01.
POSTGRES_PASSWORD=localdevwhocares

# Frontend (Phase 6)
VITE_API_TARGET=http://localhost:5009

# Compass directory seed. Documented for parity with the
# deployed-env gate name, but redundant for `dotnet run`/`make dev*` locally: api/Program.cs seeds
# unconditionally whenever IsDevelopment() is true, which local dev always is. Only a non-Development
# ASPNETCORE_ENVIRONMENT would make this flag load-bearing.
StartupTasks__SeedCompassDirectory=true
