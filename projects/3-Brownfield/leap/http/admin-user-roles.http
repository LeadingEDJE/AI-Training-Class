@baseUrl = http://localhost:5009

### Get all user roles
GET {{baseUrl}}/api/admin/user-roles
X-Dev-User: superadmin

### Get roles for a specific employee
GET {{baseUrl}}/api/admin/user-roles/by-employee/11111111-1111-1111-1111-111111111111
X-Dev-User: superadmin

### Get all users with a specific role
GET {{baseUrl}}/api/admin/user-roles/by-role/EDJEr
X-Dev-User: superadmin

### Assign a role
POST {{baseUrl}}/api/admin/user-roles
X-Dev-User: superadmin
Content-Type: application/json

{
  "edjeId": "22222222-2222-2222-2222-222222222222",
  "role": "Manager",
  "reason": "Promoted to team lead"
}

### Remove a role by ID
DELETE {{baseUrl}}/api/admin/user-roles/1
X-Dev-User: superadmin
