# engine-strict makes the `engines` floor in package.json a HARD ERROR instead of a warning.
#
# Without it, `engines` only emits EBADENGINE and npm installs anyway -- which is exactly how the
# Node-version trap this file exists to close stayed invisible. On Node 18 the root `npm ci` exits 0
# while SILENTLY SKIPPING @rolldown/binding-darwin-arm64 (an OPTIONAL dependency whose engines
# exclude 18), and optional dependencies are allowed to fail. Vite is then broken with no error at
# install time, and `make dev-all` still prints "=== Full stack running ===" and exits 0. The
# resulting failure surfaces much later, far from its cause.
#
# Switching Node afterwards is NOT enough -- `npm ci` has to be re-run, because the binding is
# missing from node_modules, not merely inert. Verify with: ls node_modules/@rolldown/binding-*
#
# `engines.npm` closes a second, narrower version trap: npm 10 and npm 11 have resolved an optional
# peer dependency chain differently before, so a lock file regenerated under npm 11 can fail
# `npm ci` under npm 10 with EUSAGE ("Missing: ... from lock file") even though nothing in
# package.json changed. Node 22 ships npm 10.x; pinning `engines.npm` to that major here makes a
# mismatched local npm fail loudly at install time instead of silently producing a lock file only
# some npm versions accept.
engine-strict=true
